# Blueberry News Aggregator - Environment Variables
# Copy this file to .env and fill in your values

# AWS Configuration (needed for Phase 2+)
AWS_REGION=us-east-1
AWS_PROFILE=default

# Agent Configuration
AGENT_NAME=ChristianBlueberryNewsAgent

# News API Configuration (if you add more sources later)
# NEWS_API_KEY=your_key_here

# Development
DEBUG=true
